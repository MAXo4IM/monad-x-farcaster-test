// Mini-App: Follow-for-Access (Monad x Farcaster)
// This React app checks if a user follows @halfin on Warpcast before revealing gated content.
// Built for the Monad Break v2 competition

import { useEffect, useState } from 'react';
import { Button } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import { toast } from "sonner";

const REQUIRED_USER = "halfin";

export default function FollowGateApp() {
  const [isConnected, setIsConnected] = useState(false);
  const [isFollowing, setIsFollowing] = useState(false);
  const [checking, setChecking] = useState(false);

  const mockCheckFollowing = async () => {
    // MOCK: Replace this with actual Farcaster graph check logic via API or Warpcast integration
    setChecking(true);
    return new Promise((resolve) => setTimeout(() => {
      const followed = Math.random() > 0.5; // Simulate check
      resolve(followed);
    }, 1000));
  };

  const handleConnect = () => {
    setIsConnected(true);
    toast("Wallet & Farcaster linked!");
  };

  const handleCheck = async () => {
    setChecking(true);
    const result = await mockCheckFollowing();
    setIsFollowing(result);
    if (!result) {
      toast("You must follow @halfin to unlock content.");
    } else {
      toast("Access granted!");
    }
    setChecking(false);
  };

  return (
    <div className="flex flex-col items-center justify-center min-h-screen p-4 space-y-4">
      <Card className="w-full max-w-md">
        <CardContent className="p-6 space-y-4">
          <h1 className="text-xl font-semibold text-center">🔒 Follow-for-Access</h1>
          <p className="text-center text-muted-foreground">
            Follow <a href="https://warpcast.com/halfin" className="text-blue-500 underline" target="_blank">@halfin</a> on Warpcast to unlock secret content.
          </p>
          {!isConnected ? (
            <Button onClick={handleConnect} className="w-full">Connect Wallet + Farcaster</Button>
          ) : (
            <>
              <Button onClick={handleCheck} className="w-full" disabled={checking}>
                {checking ? "Checking..." : "Verify Following"}
              </Button>
              {isFollowing && (
                <div className="mt-4 p-4 rounded bg-green-100 text-green-800 text-center">
                  ✅ Welcome! Here is your gated content:
                  <br />
                  <a href="https://ipfs.io/ipfs/QmExampleHash" className="text-blue-500 underline" target="_blank">Download Secret PDF</a>
                </div>
              )}
            </>
          )}
        </CardContent>
      </Card>
    </div>
  );
}
